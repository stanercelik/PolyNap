    "onboarding.napEnvironmentDescription": {
      "comment": "Description about environment suitability for naps",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie geeignet ist deine Umgebung für Nickerchen während des Tages? Berücksichtige Faktoren wie Lärmpegel, Lichtkontrolle und Komfort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How suitable is your environment for taking naps during the day? Consider factors like noise level, light control, and comfort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "日中、昼寝をするのにあなたの環境はどれくらい向いていますか？ 騒音、明るさ、快適さなどを考えてみてください。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh manakah kesesuaian persekitaran anda untuk tidur sebentar pada waktu siang? Pertimbangkan faktor seperti tahap bunyi, kawalan cahaya dan keselesaan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สภาพแวดล้อมของคุณเหมาะสมกับการงีบในตอนกลางวันแค่ไหน? พิจารณาปัจจัยต่างๆ เช่น ระดับเสียง, การควบคุมแสง, และความสบาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün içinde uyku molası vermek için ortamınız ne kadar uygun? Gürültü seviyesi, ışık kontrolü ve konfor gibi faktörleri göz önünde bulundurun."
          }
        }
      }
    },
