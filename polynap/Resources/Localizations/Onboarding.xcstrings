    "onboarding.chronotypeDescription" : {
      "comment" : "Description about morning or evening preference",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du von Natur aus morgens oder abends aktiver?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you naturally more active in the morning or evening?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "普段、朝と夜、どっちの方が元気？"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adakah anda secara semula jadi lebih aktif pada waktu pagi atau petang?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณกระตือรือร้นในตอนเช้าหรือตอนเย็นมากกว่ากันโดยธรรมชาติ?"
          }
        },
        "tr" : {
          "stringUnit" : {
