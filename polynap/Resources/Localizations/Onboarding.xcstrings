    "onboarding.ageRangeDescription": {
      "comment": "Description about age range importance",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anpassung an den polyphasischen Schlaf kann während der Jugend oder im Alter variieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polyphasic sleep adaptation may vary during adolescence or in older ages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "多相睡眠への適応は、思春期や年配の方では個人差が出やすいです。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptasi tidur polifasa mungkin berbeza semasa remaja atau pada usia yang lebih tua."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปรับตัวการนอนหลับแบบหลายเฟสอาจแตกต่างกันไปในช่วงวัยรุ่นหรือในวัยสูงอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergenlik çağında veya ileri yaşlarda polifazik uyku düzeni adaptasyonu farklılık gösterebilir."
          }
        }
      }
    },
