    "onboarding.lifestyleDescription": {
      "comment": "Description about user's daily activity level",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie würdest du dein tägliches Aktivitätsniveau beschreiben? Dies hilft uns, einen Schlafplan zu empfehlen, der deinem Energiebedarf entspricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How would you describe your daily activity level? This helps us recommend a sleep schedule that matches your energy needs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "普段の活動量はどのくらいですか？ あなたの消費カロリーに合った睡眠プランを提案します。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimanakah anda akan menggambarkan tahap aktiviti harian anda? Ini membantu kami mengesyorkan jadual tidur yang sepadan dengan keperluan tenaga anda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะอธิบายระดับกิจกรรมประจำวันของคุณอย่างไร? สิ่งนี้ช่วยให้เราแนะนำตารางการนอนหลับที่ตรงกับความต้องการพลังงานของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük aktivite düzeyinizi nasıl tanımlarsınız? Bu, enerji ihtiyaçlarınıza uygun bir uyku programı önerebilmemize yardımcı olur."
          }
        }
      }
    },
