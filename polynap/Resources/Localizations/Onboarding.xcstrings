    "onboarding.knowledgeLevelDescription": {
      "comment": "Description about user's familiarity with polyphasic sleep",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie vertraut bist du mit dem polyphasischen Schlaf? Dies hilft uns, das richtige Maß an Anleitung und Informationen bereitzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How familiar are you with polyphasic sleep? This helps us provide the right level of guidance and information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "多相睡眠について、どのくらい知っていますか？ あなたに合ったアドバイスをするための参考にします。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh manakah anda biasa dengan tidur polifasa? Ini membantu kami memberikan tahap bimbingan dan maklumat yang betul."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณคุ้นเคยกับการนอนหลับแบบหลายเฟสแค่ไหน? สิ่งนี้ช่วยให้เราให้คำแนะนำและข้อมูลในระดับที่เหมาะสมได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polifazik uyku hakkında ne kadar bilginiz var? Bu, size uygun seviyede rehberlik ve bilgi sağlamamıza yardımcı olur."
          }
        }
      }
    },
    "onboarding.lifestyle": {
      "comment": "Section title for daily lifestyle",
