    "onboarding.skip.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie das Onboarding überspringen, wird ein Standard-Schlafprogramm für Sie eingerichtet. Möchten Sie fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipping the onboarding process will set up a default sleep program for you. Do you want to proceed?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンボーディングをスキップすると、デフォルトの睡眠プログラムが設定されます。続行しますか？"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melangkau proses onboarding akan menyediakan program tidur lalai untuk anda. Adakah anda mahu meneruskan?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การข้ามขั้นตอนการเริ่มต้นใช้งานจะตั้งค่าโปรแกรมการนอนหลับเริ่มต้นสำหรับคุณ คุณต้องการดำเนินการต่อหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıtım sürecini atlamak, sizin için varsayılan bir uyku programı ayarlayacaktır. Devam etmek istiyor musunuz?"
          }
        }
      }
    },
