            "state" : "translated",
            "value" : "👥 มาก - ฉันมีภาระผูกพันและความรับผิดชอบทางสังคมที่แน่นอนหลายอย่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "👥 Önemli - Çok sayıda sabit sosyal taahhüt ve sorumluluğum var"
          }
        }
      }
    },
    "onboarding.socialObligationsDescription" : {
      "comment" : "Description about user's flexibility for social commitments",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie flexibel sind deine sozialen Verpflichtungen und täglichen Verantwortlichkeiten? Berücksichtige Familienzeit, gesellschaftliche Veranstaltungen, Treffen und andere Aktivitäten, die eine bestimmte Zeitplanung erfordern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How flexible are your social commitments and daily responsibilities? Consider family time, social events, meetings, and other activities that require specific timing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "人付き合いや日々の用事はどれくらい調整可能ですか？ 家族との時間、イベント、会議など、時間が決まっている用事を考えてみてください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sejauh manakah fleksibiliti komitmen sosial dan tanggungjawab harian anda? Pertimbangkan masa keluarga, acara sosial, mesyuarat dan aktiviti lain yang memerlukan masa tertentu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาระผูกพันทางสังคมและความรับผิดชอบประจำวันของคุณยืดหยุ่นแค่ไหน? พิจารณาเวลาครอบครัว, กิจกรรมทางสังคม, การประชุม, และกิจกรรมอื่นๆ ที่ต้องใช้เวลาที่เฉพาะเจาะจง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosyal taahhütleriniz ve günlük sorumluluklarınız ne kadar esnek? Aile zamanı, sosyal etkinlikler, toplantılar ve belirli zamanlama gerektiren diğer etkinlikleri göz önünde bulundurun."
          }
        }
      }
    },
