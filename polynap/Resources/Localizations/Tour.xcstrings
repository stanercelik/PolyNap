    "tour.step1.desc" : {
      "comment" : "Tour step 1 description - editing sleep blocks",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tippe auf bearbeiten, um blöcke zu verschieben, ziehe sie zum rand zum löschen oder nutze + um neue hinzuzufügen. tippe direkt auf einen block um zeiten anzupassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tap edit to drag and move blocks, drag to the edge to delete, or use + to add new ones. tap any block directly to adjust its times"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集をタップしてブロックをドラッグ移動、端にドラッグして削除、または+で新しいブロックを追加。ブロックを直接タップして時間を調整できます"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ketik edit untuk seret dan gerak blok, seret ke tepi untuk padam, atau gunakan + untuk tambah yang baru. ketik mana-mana blok untuk laras masa"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะแก้ไขเพื่อลากและเลื่อนบล็อก ลากไปที่ขอบเพื่อลบ หรือใช้ + เพื่อเพิ่มใหม่ แตะบล็อกใดก็ได้เพื่อปรับเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "düzenle'ye basarak blokları taşıyabilir, kenara sürükleyerek silebilir ya da + ile yeni blok ekleyebilirsin. saatlerini ayarlamak için bir bloğa direkt basabilirsin"
          }
        }
      }
    },
