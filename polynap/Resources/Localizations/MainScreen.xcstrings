    "scheduleSelection.premiumAlert.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser erweiterte Schlafplan ist für Premium-Benutzer verfügbar. Führe ein Upgrade durch, um alle polyphasischen Schlafmuster und erweiterten Funktionen freizuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This advanced sleep schedule is available for Premium users. Upgrade to unlock all polyphasic sleep patterns and advanced features."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この高度な睡眠スケジュールはプレミアムユーザー向けです。アップグレードして、すべての多相睡眠パターンと高度な機能のロックを解除しましょう。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadual tidur lanjutan ini tersedia untuk pengguna Premium. Naik taraf untuk membuka kunci semua corak tidur polifasa dan ciri lanjutan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตารางการนอนหลับขั้นสูงนี้มีให้สำหรับผู้ใช้พรีเมียม อัปเกรดเพื่อปลดล็อกรูปแบบการนอนหลับแบบหลายเฟสและฟีเจอร์ขั้นสูงทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gelişmiş uyku programı Premium kullanıcılar için mevcuttur. Tüm polifazik uyku düzenlerini ve gelişmiş özellikleri açmak için yükseltin."
          }
        }
      }
    },
