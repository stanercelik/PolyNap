    "sleepBlock.autoType" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Blocktyp wird automatisch basierend auf der Länge bestimmt. Blöcke, die länger als 45 Minuten sind, werden als Kernschlaf, kürzere als Nickerchen eingestuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Block type will be automatically determined based on length. Blocks longer than 45 minutes will be Core Sleep, shorter will be Nap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックの種類は時間によって自動で決まります。45分より長いブロックは「主睡眠」、それより短い場合は「仮眠」になります。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jenis blok akan ditentukan secara automatik berdasarkan panjang. Blok yang lebih lama daripada 45 minit akan menjadi Tidur Teras, yang lebih pendek akan menjadi Tidur Sebentar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประเภทของช่วงการนอนจะถูกกำหนดโดยอัตโนมัติตามความยาว ช่วงที่ยาวกว่า 45 นาทีจะเป็นการนอนหลัก, สั้นกว่าจะเป็นการงีบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blok türü süreye bağlı olarak otomatik belirlenecektir. 45 dakikadan uzun bloklar Ana Uyku, daha kısa olanlar Şekerleme olacaktır."
          }
        }
      }
    },
