    "alarm.sleep.reminder.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' Programm bei %@ Schlaf steht kurz bevor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' schedule %@ sleep is about to start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'スケジュールの%@睡眠が始まります。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadual '%@' tidur %@ akan bermula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลา '%@' การนอน %@ กำลังจะเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' programındaki %@ uykunuz başlamak üzere."
          }
        }
      }
    },
    "alarm.sleep.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⏰ Schlafzeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⏰ Sleep Time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⏰ 睡眠時間"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "⏰ Masa Tidur"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "⏰ เวลานอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⏰ Uyku Zamanı"
          }
        }
      }
    },
    "alarm.snoozed.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit zum Aufwachen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to wake up!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる時間です！"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa untuk bangun!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงเวลาตื่นแล้ว!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanma zamanı geldi!"
          }
        }
      }
    },
    "alarm.snoozed.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "😴 Verschobener Alarm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😴 Snoozed Alarm"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "😴 スヌーズアラーム"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "😴 Penggera Ditunda"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "😴 นาฬิกาปลุกที่เลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "😴 Ertelenmiş Alarm"
          }
        }
      }
    },
    "alarm.test.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Testbenachrichtigung für Ihre Alarmeinstellungen. Tippen Sie auf die Benachrichtigung, um die App zu öffnen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a test notification for your alarm settings. Tap the notification to open the app!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはアラーム設定のテスト通知です。通知をタップしてアプリを開いてください！"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah pemberitahuan ujian untuk tetapan penggera anda. Ketik pemberitahuan untuk membuka aplikasi!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่เป็นการแจ้งเตือนทดสอบสำหรับการตั้งค่าปลุกของคุณ แตะการแจ้งเตือนเพื่อเปิดแอป!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, alarm ayarlarınız için bir test bildirimidir. Bildirime dokunarak uygulamayı açın!"
          }
        }
      }
    },
    "alarm.test.title": {
      "extractionState": "manual",
      "localizations": {
