    "alarm.wake.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Schlafzeitraum ist beendet. Zeit aufzustehen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sleep period is complete. Time to get up!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠期間が終了しました。起きる時間です！"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempoh tidur anda telah selesai. Masa untuk bangun!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงการนอนของคุณเสร็จสิ้นแล้ว ถึงเวลาตื่นแล้ว!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku periyodunuz tamamlandı. Haydi güne başla!"
          }
        }
      }
    },
    "alarm.wake.scheduled.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Schlafblock ist beendet. Guten Morgen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sleep block has ended. Good morning!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠ブロックが終了しました。おはようございます！"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Blok tidur anda telah berakhir. Selamat pagi!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงการนอนของคุณจบแล้ว สวัสดีตอนเช้า!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku bloğunuz sona erdi. Günaydın!"
          }
        }
      }
    },
